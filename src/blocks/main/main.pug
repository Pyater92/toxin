main.main
    .wrapper
      .main-container
        .find-form
          h1.find-form__title Найдём номера под ваши пожелания
          ul
            li
              .find-form__dates
                .date-coming
                  span.title ПРИБЫТИЕ
                  input.date-box(placeholder="ДД.ММ.ГГГГ" name="arrival" required="")  
                  img.expand-coming(src=require("/src/assets/img/svg/expand_more.svg"), alt="")
                  .input-date-click-area
                       
                .date-leaving
                  span.title ВЫЕЗД
                  input.date-box(placeholder="ДД.ММ.ГГГГ" name="arrival" required="")
                  img.expand-leaving(src=require("/src/assets/img/svg/expand_more.svg"), alt="")
                  .input-date-click-area
          ul
            li
              .find-form__guests
                span.title ГОСТИ
                .dropdown-guests
                  .box-guests 
                    p.number-guests Сколько гостей 
                    img.expand(src=require("/src/assets/img/svg/expand_more.svg"), alt="")
                    .dropdown-guests__content
                      ul
                        li
                          .dropdown-guests__item
                            span.title взрослые
                            .dropdown-guests__item-control
                              button.math-symbol -
                              .number 1
                              button.math-symbol +
                      ul
                        li
                          .dropdown-guests__item
                            span.title дети
                            .dropdown-guests__item-control
                              .math-symbol -
                              .number 1
                              .math-symbol +
                      ul
                        li
                          .dropdown-guests__item
                            span.title младенцы
                            .dropdown-guests__item-control
                              .math-symbol -
                              .number 1
                              .math-symbol +
                      ul
                        li
                          .dropdown-guests__buttons
                            button.clean Очистить
                            button.apply Применить
                      
          ul
            li
              a.personal__link(href="/")
                .pickup-button
                  p.pickup-button__title ПОДОБРАТЬ НОМЕР
                  img.arrow-forward(src=require("/src/assets/img/svg/arrow_forwardWhite.svg"), alt="")
        .slogan
          p
          | Лучшие номера для вашей работы,
          br
          |
          | отдыха и просто вдохновения
          br
          |
