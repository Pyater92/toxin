footer
  .wrapper
    .footer-container
      .footer-container__upper
        .footer-container__resume
            .item
              .logo
                  img(
                    src=require("/src/assets/img/svg/toxin_logo.svg"),
                    alt="Логотип TOXIN"
                  )          
              p.resume-text
                | Бронирование номеров в лучшем
                br
                |
                | отеле 2019 года по версии
                br
                |
                | ассоциации «Отельные взгляды»
        nav.footer-container__site-map.footer-nav
            span.title НАВИГАЦИЯ
            a.link(href="#!") О нас
            a.link(href="#!") Новости
            a.link(href="#!") Служба поддержки
            a.link(href="#!") Услуги          
        nav.footer-container__about.footer-nav
            span.title О НАС
            a.link(href="#!") О сервисе
            a.link(href="#!") Наша команда
            a.link(href="#!") Вакансии
            a.link(href="#!") Инвесторы          
        nav.footer-container__helpdesk.footer-nav
            span.title СЛУЖБА ПОДДЕРЖКИ
            a.link(href="#!") Соглашения
            a.link(href="#!") Сообщества
            a.link(href="#!") Связь с нами          
        .socials.footer-nav
            span.title ПОДПИСКА
            .socials__item
                p
                | Получайте специальные
                br
                | предложения и новости сервиса        
            .socials__form
                p.socials__adds Email
                img.arrowForwardLila(src=require("/src/assets/img/svg/arrow_forwardLila.svg"), alt="")
  .footer-container__line
  .wrapper
    .footer-container__down
       .footer-container__copyright
         p Copyright © 2018 Toxin отель. Все права защищены.
       .footer-container__twitter
         img(src=require("/src/assets/img/svg/twit.svg"), alt="Twitter")
       .footer-container__fb
         img(src=require("/src/assets/img/svg/fb.svg"), alt="Facebook")
       .footer-container__instagram
         img(src=require("/src/assets/img/svg/inst.svg"), alt="Instagram")
