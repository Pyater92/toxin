doctype html
html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title T0XIN - Бронирование номеров
    link(rel="stylesheet", href="https://code.jquery.com/ui/1.14.0/themes/base/jquery-ui.css")
    link(rel="stylesheet", href="/resources/demos/style.css")
    script(src="https://code.jquery.com/jquery-3.7.1.js")
    script(src="https://code.jquery.com/ui/1.14.0/jquery-ui.js")
    link(href=require('./_landing.scss') rel='stylesheet')
    
    script(src='../landing/landing.js' defer="defer")
    
  body
    include /src/blocks/header/header
    main.main
      .wrapper
        .main-container
          .find-form
            .find-form__wrapper
              h1.find-form__title Найдём номера под ваши пожелания
              .find-form__dates
                .date-coming
                  span.title ПРИБЫТИЕ
                  input.date-box(placeholder="ДД.ММ.ГГГГ" name="arrival" required="")  
                  .find-form__click-area
                    img.expand-coming(src=require("/src/assets/img/svg/expand_more.svg"), alt="")                    
                .date-leaving
                  span.title ВЫЕЗД
                  input.date-box(placeholder="ДД.ММ.ГГГГ" name="arrival" required="")
                  .find-form__click-area
                    img.expand-leaving(src=require("/src/assets/img/svg/expand_more.svg"), alt="")        
              .find-form__guests
                span.title ГОСТИ
                input.box-guests.box-guests__landing-page(placeholder="Сколько гостей" name="arrival" required="")
                .guests__click-area
                  img.expand-guests(src=require("/src/assets/img/svg/expand_more.svg"), alt="")
                .guests__dropdown
                  .guests__dropdown-container
                    .guests__dropdown-item
                      span.title взрослые
                      .guests__dropdown-control
                        button.math-symbol -
                        .number 0
                        button.math-symbol +
                    .guests__dropdown-item
                          span.title дети
                          .guests__dropdown-control
                            button.math-symbol -
                            .number 0
                            button.math-symbol +
                    .guests__dropdown-item
                      span.title младенцы
                      .guests__dropdown-control
                        button.math-symbol -
                        .number 0
                        button.math-symbol +
                    .guests__dropdown-buttons
                      button.clean Очистить
                      button.apply Применить
              a.personal__link(href="./search.html")
                .pickup-button
                  .pickup-button__title ПОДОБРАТЬ НОМЕР
                  img.arrow-forward(src=require("/src/assets/img/svg/arrow_forwardWhite.svg"), alt="")
          .slogan
            p
            | Лучшие номера для вашей работы,
            br
            |
            | отдыха и просто вдохновения
            br
            |
    include /src/blocks/footer/footer