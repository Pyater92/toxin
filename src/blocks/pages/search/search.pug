doctype html
html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title T0XIN - Бронирование номеров
    link(rel="stylesheet", href="https://code.jquery.com/ui/1.14.0/themes/base/jquery-ui.css")
    link(rel="stylesheet", href="/resources/demos/style.css")
    script(src="https://code.jquery.com/jquery-3.7.1.js")
    script(src="https://code.jquery.com/ui/1.14.0/jquery-ui.js")
    link(href=require('./search.scss') rel='stylesheet')    
    script(src='../search/search.js' defer="defer")
    
    
  body
    include /src/blocks/header/header
    main.search-page
      .wrapper
        .search-room-container
          .filter
            .find-form__guests
              span.title даты пребывания в отеле
              input.box-guests(placeholder="19 авг - 23 авг" name="arrival" required="")
              img.expand-residence(src=require("/src/assets/img/svg/expand_more.svg"), alt="")
              .find-form__click-area
            .find-form__guests
              span.title гости
              input.box-guests(placeholder="3 гостя, 1 младенец" name="arrival" required="")
              img.expand-residence(src=require("/src/assets/img/svg/expand_more.svg"), alt="")
              .guests__click-area
              .guests__dropdown
                      ul
                        li
                          .guests__dropdown-item
                            span.title взрослые
                            .guests__dropdown-control
                              button.math-symbol -
                              .number 1
                              button.math-symbol +
                      ul
                        li
                          .guests__dropdown-item
                            span.title дети
                            .guests__dropdown-control
                              button.math-symbol -
                              .number 1
                              button.math-symbol +
                      ul
                        li
                          .guests__dropdown-item
                            span.title младенцы
                            .guests__dropdown-control
                              button.math-symbol -
                              .number 1
                              button.math-symbol +
                      ul
                        li
                          .guests__dropdown-buttons
                            button.clean Очистить
                            button.apply Применить
            .find-form__range-cost.range
              .range__headlink
                span.title диапазон цены
                input.range__display(type="text" readonly="" value="5 000₽ - 10 000₽")
              .range__slider-range                
              span.range__description Стоимость за сутки пребывания в номере
            .find-form__rules
              span.title правила дома
              .find-form__container
                label.checkbox
                  input.checkbox__indicator(type="checkbox")
                  .checkbox__container
                    .link Можно курить
                label.checkbox
                  input.checkbox__indicator(type="checkbox")
                  .checkbox__container
                    .link Можно с питомцами
                label.checkbox
                  input.checkbox__indicator(type="checkbox")
                  .checkbox__container
                    .link 
                      | Можно пригласить гостей 
                      br
                      | (до 10 человек)
            .find-form__accessibility
              span.title доступность
              .find-form__container
                label.checkbox
                  input.checkbox__indicator(type="checkbox")
                  .checkbox__container
                    .link-bold Широкий коридор
                    .checkbox__sub-container 
                      .link 
                      | Ширина коридоров в номере 
                      br
                      | не менее 91 см.
                label.checkbox
                  input.checkbox__indicator(type="checkbox")
                  .checkbox__container
                    .link-bold Помощник для инвалидов
                    .checkbox__sub-container  
                      .link 
                        | На 1 этаже вас встретит специалист  
                        br
                        | и проводит до номера.
            .find-form__convenience
              span.title удобства номера
              input.box-guests(placeholder="2 спальни, 2 кровати..." name="arrival" required="")
              img.expand-residence(src=require("/src/assets/img/svg/expand_more.svg"), alt="")
              .convenience__click-area
              .convenience__dropdown
                ul
                  li
                    .convenience__dropdown-item
                      span.title спальни
                      .convenience__dropdown-control
                        button.math-symbol -
                        .number 1
                        button.math-symbol +
                ul
                  li
                    .convenience__dropdown-item
                      span.title кровати
                      .convenience__dropdown-control
                        button.math-symbol -
                        .number 1
                        button.math-symbol +
                ul
                  li
                    .convenience__dropdown-item
                      span.title ванные комнаты
                      .convenience__dropdown-control
                        button.math-symbol -
                        .number 1
                        button.math-symbol +
            .find-form__advanced-convenience
              span.title дополнительные удобства
              .find-form__container
                label.checkbox
                  input.checkbox__indicator(type="checkbox")
                  .checkbox__container
                    .link Завтрак
                label.checkbox
                  input.checkbox__indicator(type="checkbox")
                  .checkbox__container
                    .link Письменный стол
                label.checkbox
                  input.checkbox__indicator(type="checkbox")
                  .checkbox__container
                    .link Стул для кормления
                label.checkbox
                  input.checkbox__indicator(type="checkbox")
                  .checkbox__container
                    .link Кроватка
                label.checkbox
                  input.checkbox__indicator(type="checkbox")
                  .checkbox__container
                    .link Телевизор
                label.checkbox
                  input.checkbox__indicator(type="checkbox")
                  .checkbox__container
                    .link Шампунь
          .rooms
            .rooms-list
              h3.rooms-list__title Номера, которые мы для вас подобрали
              .rooms-list__container
                ul
                  li
                    .rooms-item
                      .rooms-item__image
                        img(src=require("/src/assets/img/888.jpg") alt="")
                      .rooms-item__container
                        .rooms-item__description
                          .rooms-item__description-up
                            p.rooms-item__room №
                              span.rooms-item__room-number 888
                              span.rooms-item__room-type люкс
                            p.rooms-item__cost
                              span.rooms-item__cost-number 9 990₽
                              span.rooms-item__cost-title в сутки
                          .rooms-item__description-down
                            p.rooms-item__stars
                            p.rooms-item__review

                  li 
                    .rooms-list__item
                  li
                    .rooms-list__item
                ul
                  li
                    .rooms-list__item
                  li 
                    .rooms-list__item
                  li
                    .rooms-list__item
                ul
                  li
                    .rooms-list__item
                  li 
                    .rooms-list__item
                  li
                    .rooms-list__item
                
                ul
                  li
                    .rooms-list__item
                  li 
                    .rooms-list__item
                  li
                    .rooms-list__item
                














    include /src/blocks/footer/footer